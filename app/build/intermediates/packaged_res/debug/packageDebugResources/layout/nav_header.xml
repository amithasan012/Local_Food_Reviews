<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="148dp"
    android:background="@color/food_primary"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView android:id="@+id/drawer_username" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local Food Reviews" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/drawer_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Share a dish. Find a favourite." android:textColor="#BBDEFB" android:textSize="14sp" />
</LinearLayout>
